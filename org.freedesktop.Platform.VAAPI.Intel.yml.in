id: org.freedesktop.Platform.VAAPI.Intel
branch: '@BRANCH@'
runtime: org.freedesktop.Platform
runtime-version: '@BRANCH@'
sdk: org.freedesktop.Sdk
build-extension: true
separate-locales: false
appstream-compose: false

modules:
  - name: libpciaccess
    buildsystem: meson
    config-opts:
      - --prefix=/usr/lib/x86_64-linux-gnu/dri/intel-vaapi-driver
      - --libdir=lib
      - --buildtype=release
    sources:
      - type: archive
        url: https://xorg.freedesktop.org/archive/individual/lib/libpciaccess-0.19.tar.xz
        sha256: 3c55aa86c82e54a4e3109786f0463530d53b36b6d1cfd14616454f985dd2aa43

  - name: libdrm
    buildsystem: meson
    build-options:
      ldflags: '-Wl,-rpath,$ORIGIN'
    config-opts:
      - --prefix=/usr/lib/x86_64-linux-gnu/dri/intel-vaapi-driver
      - --libdir=lib
      - --buildtype=release
      - -Dintel=enabled
      - -Dradeon=disabled
      - -Damdgpu=disabled
      - -Dnouveau=disabled
      - -Dvmwgfx=disabled
      - -Domap=disabled
      - -Dexynos=disabled
      - -Dfreedreno=disabled
      - -Dtegra=disabled
      - -Dvc4=disabled
      - -Detnaviv=disabled
      - -Dcairo-tests=disabled
      - -Dtests=false
      - -Dinstall-test-programs=false
      - -Dvalgrind=disabled
      - -Dudev=false
      - -Dman-pages=disabled
    sources:
      - type: archive
        url: https://dri.freedesktop.org/libdrm/libdrm-2.4.134.tar.xz
        sha256: ac5e74d157830eb8bee44c6a6bf3ad49774ef0dd2a72bdad74a8f20308b52a95

  - name: intel-vaapi-driver-irql
    buildsystem: simple
    license-files:
      - driver-src/LICENSE
    build-commands:
      - |
        set -eu

        LIBDIR="${FLATPAK_DEST}/lib"

        test "${FLATPAK_DEST}" = "/usr/lib/x86_64-linux-gnu/dri/intel-vaapi-driver" || {
          echo "FLATPAK_DEST is '${FLATPAK_DEST}'; update --prefix in libpciaccess and libdrm" >&2
          exit 1
        }
        test -f "${LIBDIR}/pkgconfig/libdrm_intel.pc" || {
          echo "Missing ${LIBDIR}/pkgconfig/libdrm_intel.pc (libdrm did not install here)" >&2
          exit 1
        }
        export PKG_CONFIG_PATH="${LIBDIR}/pkgconfig:${FLATPAK_DEST}/share/pkgconfig:${PKG_CONFIG_PATH:-}"
        echo "Building against libdrm_intel $(pkg-config --print-errors --modversion libdrm_intel)"

        BASE_LDFLAGS="${LDFLAGS:-}"
        export LDFLAGS="${BASE_LDFLAGS} -Wl,-rpath,\$ORIGIN/lib"
        meson setup _driver-build driver-src \
          --prefix=/usr \
          --buildtype=release \
          -Ddriverdir=/usr/lib/x86_64-linux-gnu/dri/intel-vaapi-driver \
          -Dwith_x11=yes \
          -Dwith_wayland_drm=no \
          -Denable_tests=false
        meson compile -C _driver-build

        DESTDIR="$PWD/_driver-stage" meson install -C _driver-build --no-rebuild
        DRIVER="$(find _driver-stage -name i965_drv_video.so -print -quit)"
        test -n "$DRIVER" || {
          echo "i965_drv_video.so not found in _driver-stage" >&2
          exit 1
        }
        install -Dm755 "$DRIVER" "${FLATPAK_DEST}/i965_drv_video.so"
        printf 'intel-vaapi-driver IRQL fork\ncommit @COMMIT@\nbranch @BRANCH@\n' \
          > "${FLATPAK_DEST}/BUILD-INFO"

        ls "${LIBDIR}"/libdrm_intel.so.1* >/dev/null || {
          echo "libdrm_intel.so.1 missing from ${LIBDIR}" >&2
          exit 1
        }

        command -v readelf >/dev/null 2>&1 || {
          echo "readelf is required to verify driver library paths" >&2
          exit 1
        }
        for f in "${FLATPAK_DEST}/i965_drv_video.so" "${LIBDIR}/libdrm_intel.so.1"; do
          if ! readelf -d "$f" | grep -Eq '(RPATH|RUNPATH).*\$ORIGIN'; then
            echo "Expected an RPATH/RUNPATH containing \$ORIGIN in $f" >&2
            exit 1
          fi
        done

        echo "Extension contents before pruning:"
        find "${FLATPAK_DEST}" \( -type f -o -type l \) | sort

        find "${FLATPAK_DEST}" -mindepth 1 \
          ! -path "${FLATPAK_DEST}/BUILD-INFO" \
          ! -path "${FLATPAK_DEST}/i965_drv_video.so" \
          ! -path "${LIBDIR}" \
          ! -path "${LIBDIR}/libdrm_intel.so.1*" \
          -delete

        echo "Extension contents after pruning:"
        find "${FLATPAK_DEST}" \( -type f -o -type l \) | sort

    sources:
      - type: git
        url: https://github.com/irql-notlessorequal/intel-vaapi-driver.git
        commit: '@COMMIT@'
        dest: driver-src
